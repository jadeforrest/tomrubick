---
import BaseLayout from '../layouts/BaseLayout.astro';

// Full list captured from the Wix "Exhibits" page (33 entries, 1986–2007).
// Ordered newest first. The Wix source itself was not strictly chronological;
// entries are sorted descending here, with the multi-year Faculty Exhibit placed
// after the last single-year entry it spans.
const exhibits = [
  { year: '2007', text: '“The Last Exhibition,” a four-person show of nineteen paintings — Opus 6ix Gallery, Eugene (October)' },
  { year: '2006', text: '“Look! Positive Sexuality in Art” — North Santiam Hall Gallery, Linn-Benton Community College, Albany (August 2–30)' },
  { year: '2006', text: '“Community College Invitational” — Opus 6ix Gallery, Eugene (January–March)' },
  { year: '2005–06', text: '“La Petite XIV” — Maude Kerns Art Center, Eugene' },
  { year: '2005', text: '“12″ Show” — Alder Gallery, Coburg (December)' },
  { year: '2005', text: '“Art for All Seasons 2005” — Springfield Arts Commission, Springfield (November–December)' },
  { year: '2005', text: '“International Mail Art Exhibit” — Jacobs Gallery, Eugene (September–October)' },
  { year: '2005', text: '“2005 Mayor’s Show” — Gallery at the Airport, Eugene (September–October)' },
  { year: '2005', text: '“For the Birds” — La Follette Gallery, Eugene (August–December)' },
  { year: '2005', text: '“Pears: An Invitational Show” — DIVA Gallery, Eugene (June–July)' },
  { year: '2005', text: '“Figuratively Speaking 2” — Maude Kerns Art Center, Eugene' },
  { year: '2005', text: '“Artists Who Teach” — Downtown Initiative for the Visual Arts (DIVA), Eugene' },
  { year: '2005', text: 'Solo exhibition' },
  { year: '2004', text: '“100 Banners for 100 Years” — Eugene Public Library' },
  { year: '2004', text: '“The Human Form” — Newport Visual Arts Center, Newport' },
  { year: '2004', text: '“For the Love of Art: A Valentine’s Invitational” — DIVA Gallery, Eugene' },
  { year: '2004', text: '“Pixel Rev(s)olution” — Mt. Hood Community College, Fireplace Gallery, Gresham' },
  { year: '2003', text: '“No War Art Show” — New Zone Gallery, Eugene' },
  { year: '2002–03', text: '“La Petite XI” — Alder Gallery, Coburg' },
  { year: '2002', text: '“Bid for Beauty” — Maude Kerns Art Center, Eugene' },
  { year: '2002', text: '“Figuratively Speaking” — Maude Kerns Art Center' },
  { year: '2002', text: '“The Creative Path” — Eugene Airport Gallery' },
  { year: '2001', text: '“Works on Paper” — Robert Canaga Gallery' },
  { year: '2001', text: '“Nudes! All Nudes!” — Robert Canaga Gallery' },
  { year: '2001', text: '“Figure 2001” — Pinckney Gallery' },
  { year: '2000', text: '“Mayor’s Show 2000” — The Jacobs Gallery' },
  { year: '2000', text: '“E-Art” — Maude Kerns Art Center' },
  { year: '2000', text: '“Focus on the Figure” — Maude Kerns Art Center' },
  { year: '2000', text: 'Three-artist show — The Reddick Gallery' },
  { year: '1999', text: '“Computer Art” — Lane Community College Gallery' },
  { year: '1988–present', text: 'Faculty Exhibit — Lane Community College Gallery' },
  { year: '1987', text: '“The Layered Look: West Coast Collage” — University of Oregon Art Museum' },
  { year: '1986', text: 'Three-artist show — Maude Kerns Art Center' },
];
---

<BaseLayout title="Exhibits" description="Selected exhibitions of Thomas Rubick's work.">
  <h1 class="page-title">Exhibits</h1>
  <div class="prose">
    <ul class="exhibits">
      {
        exhibits.map((e) => (
          <li>
            <span class="year">{e.year}</span>
            <span class="what" set:html={e.text} />
          </li>
        ))
      }
    </ul>
  </div>
</BaseLayout>

<style>
  .exhibits {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .exhibits li {
    display: flex;
    gap: 1rem;
    padding: 0.6rem 0;
    border-bottom: 1px solid var(--rule);
  }
  .year {
    flex: 0 0 7rem;
    font-variant-numeric: tabular-nums;
    color: var(--muted);
  }
  @media (max-width: 480px) {
    .exhibits li {
      flex-direction: column;
      gap: 0.15rem;
    }
    .year {
      flex: none;
    }
  }
</style>
