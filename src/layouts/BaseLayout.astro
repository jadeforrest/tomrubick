---
import { getGalleryNav } from '../lib/galleries';
import Contact from '../components/Contact.astro';

interface Props {
  title: string;
  description?: string;
  /** Optional path (e.g. /og/paintings.jpg) for social share previews. */
  ogImage?: string;
}

const {
  title,
  description = "The artwork of Thomas Rubick — painter, illustrator, and designer.",
  ogImage,
} = Astro.props;

// Galleries first (in categories.ts order), then the static pages.
const navItems = [
  ...getGalleryNav().map((g) => ({ href: `/${g.slug}`, label: g.label })),
  { href: '/biography', label: 'Biography' },
  { href: '/exhibits', label: 'Exhibits' },
  { href: '/about-this-site', label: 'About this site' },
];

const here = Astro.url.pathname.replace(/\/$/, '') || '/';
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImageUrl = ogImage ? new URL(ogImage, Astro.site) : undefined;
const fullTitle = title === 'Thomas Rubick' ? title : `${title} — Thomas Rubick`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical.href} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical.href} />
    {ogImageUrl && <meta property="og:image" content={ogImageUrl.href} />}
    <meta name="twitter:card" content={ogImageUrl ? 'summary_large_image' : 'summary'} />
  </head>
  <body>
    <header class="site-header">
      <a class="site-title" href="/">Thomas Rubick</a>
      <nav class="site-nav" aria-label="Primary">
        <ul>
          {
            navItems.map((item) => (
              <li>
                <a href={item.href} aria-current={here === item.href ? 'page' : undefined}>
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
    </header>

    <main class="site-main">
      <slot />
    </main>

    <footer class="site-footer">
      <Contact compact />
      <p class="copyright">© {new Date().getFullYear()} the Estate of Thomas Rubick.</p>
    </footer>

    <style is:global>
      :root {
        --bg: #fbfbf9;
        --fg: #1c1b19;
        --muted: #6b6862;
        --rule: #e3e0d8;
        --accent: #1c1b19;
        --maxw: 1200px;
        --gap: 1.5rem;
        --serif: Georgia, 'Times New Roman', serif;
        --sans: -apple-system, BlinkMacSystemFont, 'Segoe UI', Helvetica, Arial, sans-serif;
      }

      * {
        box-sizing: border-box;
      }

      html {
        -webkit-text-size-adjust: 100%;
      }

      body {
        margin: 0;
        background: var(--bg);
        color: var(--fg);
        font-family: var(--sans);
        line-height: 1.6;
        display: flex;
        flex-direction: column;
        min-height: 100vh;
      }

      a {
        color: inherit;
      }

      img {
        max-width: 100%;
        height: auto;
        display: block;
      }

      /* ---- Header / nav ---- */
      .site-header {
        max-width: var(--maxw);
        width: 100%;
        margin: 0 auto;
        padding: 2rem 1.5rem 1rem;
        text-align: center;
      }

      .site-title {
        font-family: var(--serif);
        font-size: clamp(1.8rem, 4vw, 2.6rem);
        letter-spacing: 0.04em;
        text-decoration: none;
        font-weight: 400;
      }

      .site-nav {
        margin-top: 1.25rem;
        border-top: 1px solid var(--rule);
        border-bottom: 1px solid var(--rule);
        padding: 0.5rem 0;
      }

      .site-nav > ul {
        list-style: none;
        margin: 0;
        padding: 0;
        display: flex;
        flex-wrap: wrap;
        justify-content: center;
        gap: 0.25rem 1.5rem;
      }

      .site-nav a {
        text-decoration: none;
        font-size: 0.82rem;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        color: var(--muted);
        padding: 0.35rem 0.1rem;
        display: inline-block;
        transition: color 0.15s ease;
      }

      .site-nav a:hover,
      .site-nav a:focus-visible,
      .site-nav a[aria-current='page'] {
        color: var(--fg);
      }

      /* ---- Main ---- */
      .site-main {
        max-width: var(--maxw);
        width: 100%;
        margin: 0 auto;
        padding: 2.5rem 1.5rem 3.5rem;
        flex: 1 0 auto;
      }

      .page-title {
        font-family: var(--serif);
        font-weight: 400;
        font-size: clamp(1.4rem, 3vw, 2rem);
        text-align: center;
        margin: 0 0 2rem;
      }

      .prose {
        max-width: 42rem;
        margin: 0 auto;
        font-size: 1.05rem;
      }

      .prose h2 {
        font-family: var(--serif);
        font-weight: 400;
      }

      /* ---- Footer ---- */
      .site-footer {
        border-top: 1px solid var(--rule);
        margin-top: auto;
        padding: 2rem 1.5rem;
        text-align: center;
        color: var(--muted);
        font-size: 0.9rem;
      }

      .site-footer a {
        color: var(--fg);
      }

      .copyright {
        margin: 0.75rem 0 0;
        font-size: 0.78rem;
        letter-spacing: 0.04em;
      }

      @media (max-width: 600px) {
        .site-nav > ul {
          gap: 0.25rem 1rem;
        }
        .site-nav a {
          font-size: 0.72rem;
        }
      }
    </style>
  </body>
</html>
